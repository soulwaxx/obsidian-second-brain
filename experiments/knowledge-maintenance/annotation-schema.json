{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "knowledge-maintenance-annotation-v3",
  "$defs": {
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["checkpoint", "path", "sourceHash", "start", "end", "quote"],
      "properties": {"checkpoint": {"type": "string"}, "path": {"type": "string"}, "sourceHash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "start": {"type": "integer", "minimum": 0}, "end": {"type": "integer", "minimum": 1}, "quote": {"type": "string", "minLength": 1}}
    },
    "claim": {
      "type": "object", "additionalProperties": false,
      "required": ["quote", "start", "end", "unitQuote", "unitStart", "unitEnd", "disposition", "temporal", "relation", "priorSupport", "qualifiers", "explanation", "currentEvidence", "historicalEvidence"],
      "properties": {
        "quote": {"type": "string", "minLength": 1}, "start": {"type": "integer", "minimum": 0}, "end": {"type": "integer", "minimum": 1},
        "unitQuote": {"type": "string", "minLength": 1}, "unitStart": {"type": "integer", "minimum": 0}, "unitEnd": {"type": "integer", "minimum": 1},
        "disposition": {"enum": ["supported", "unsupported", "unknown"]}, "temporal": {"enum": ["current", "historical", "mixed", "unknown"]},
        "relation": {"enum": ["supported", "contradicted", "not-addressed", "unknown"]}, "priorSupport": {"enum": ["supported", "unsupported", "unknown"]},
        "qualifiers": {"enum": ["preserved", "dropped", "not-applicable", "unknown"]}, "explanation": {"type": "string"},
        "currentEvidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}}, "historicalEvidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}}
      }
    },
    "answerJudgment": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "answerHash", "complete", "outcome", "coveredTopics", "explanation", "claims"],
      "properties": {"schemaVersion": {"const": 3}, "answerHash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "complete": {"type": "boolean"}, "outcome": {"enum": ["supported", "abstained", "unsupported", "unknown"]}, "coveredTopics": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "explanation": {"type": "string"}, "claims": {"type": "array", "items": {"$ref": "#/$defs/claim"}}}
    },
    "wikiTopic": {
      "type": "object", "additionalProperties": false,
      "required": ["topic", "status", "path", "pageHash", "quote", "start", "end", "temporal", "relation", "priorSupport", "currentEvidence", "historicalEvidence", "history", "qualifiers"],
      "properties": {
        "topic": {"type": "string"}, "status": {"enum": ["supported", "abstained", "unsupported", "unknown"]},
        "path": {"type": ["string", "null"]}, "pageHash": {"type": ["string", "null"]}, "quote": {"type": ["string", "null"]}, "start": {"type": ["integer", "null"]}, "end": {"type": ["integer", "null"]},
        "temporal": {"enum": ["current", "historical", "mixed", "unknown"]}, "relation": {"enum": ["supported", "contradicted", "not-addressed", "unknown"]},
        "priorSupport": {"enum": ["supported", "unsupported", "unknown"]}, "currentEvidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}}, "historicalEvidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
        "history": {"enum": ["preserved", "lost", "not-applicable", "unknown"]}, "qualifiers": {"enum": ["preserved", "dropped", "not-applicable", "unknown"]}
      }
    },
    "wikiJudgment": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "checkpoint", "snapshotHash", "previousSnapshotHash", "changeAssessment", "complete", "topics", "pageTopics", "unnecessaryChanges", "unauthorizedWriteAttempts"],
      "properties": {"schemaVersion": {"const": 3}, "checkpoint": {"type": "string"}, "snapshotHash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "previousSnapshotHash": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}, "changeAssessment": {"enum": ["initialization", "assessed", "unknown"]}, "complete": {"type": "boolean"}, "topics": {"type": "array", "items": {"$ref": "#/$defs/wikiTopic"}}, "pageTopics": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["path", "topics"], "properties": {"path": {"type": "string"}, "topics": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}}}}, "unnecessaryChanges": {"oneOf": [{"type": "null"}, {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["path", "reason"], "properties": {"path": {"type": "string"}, "reason": {"type": "string"}}}}]}, "unauthorizedWriteAttempts": {"type": "array", "items": {"enum": ["write", "delete", "shell-write", "out-of-scope", "host-path"]}}}
    }
  }
}
