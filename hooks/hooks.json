{
  "hooks": {
    "PreToolUse": [
      { "matcher": "Edit|MultiEdit|NotebookEdit|Write", "hooks": [{ "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/obsidian-session.sh\" prewrite", "timeout": 5 }] }
    ],
    "SessionStart": [
      { "matcher": "startup|resume", "hooks": [{ "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/obsidian-session.sh\" start", "timeout": 10 }] }
    ],
    "PostToolUse": [
      { "matcher": "Edit|MultiEdit|NotebookEdit|Write", "hooks": [{ "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/obsidian-session.sh\" autocommit", "timeout": 15 }] }
    ],
    "Stop": [
      { "matcher": "", "hooks": [{ "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/obsidian-session.sh\" stop", "timeout": 10 }] }
    ]
  }
}
